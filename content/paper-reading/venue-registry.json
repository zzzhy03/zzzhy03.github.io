  "globalPolicyOverrides": [
    {
      "id": "core-project-topic-override",
      "priority": 100,
      "topicIds": [
        "lego",
        "embroidery"
      ],
      "venueRequirement": "none",
      "admitWhenZh": "研究对象真正是 LEGO 或 embroidery，且主要贡献属于 AI、Computer Graphics、Computer Vision、generation、representation、segmentation、reconstruction、editing、planning 或 computational fabrication。"
    },
    {
      "id": "broad-radar-landmark-threshold",
      "priority": 90,
      "topicIds": [
        "llm",
        "image-generation",
        "video-generation"
      ],
      "venueRequirement": "soft",
      "admitWhenZh": "提出重大模型、能力边界、广泛影响的范式，或对核心研究有直接迁移价值；P0 venue 本身不足以满足。"
    },
    {
      "id": "selective-3d-reconstruction-threshold",
      "priority": 80,
      "topicIds": [
        "3d-reconstruction"
      ],
      "venueRequirement": "soft",
      "admitWhenZh": "出现实质范式变化，或对 3D Generation、LEGO、Segmentation、editable assets 或 Fabrication 有清晰迁移价值。"
    },
    {
      "id": "main-track-default",
      "priority": 10,
      "topicIds": [
        "*"
      ],
      "venueRequirement": "soft",
      "admitWhenZh": "Main conference 或 journal content 仍须通过对应方向门槛；workshop、demo 和 extended abstract 默认不收。"
    }
  ],
  "nonVenueSources": [
    {
      "id": "preprint",
