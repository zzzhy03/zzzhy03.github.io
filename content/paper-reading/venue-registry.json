      "admitIfAnyZh": [
        "精确命中 LEGO 或 Embroidery 技术主题。",
        "对主要方向有清晰且完整的方法贡献，尚无正式 publication。",
        "满足 broad-radar landmark threshold。",
        "对 active project 有异常强的直接迁移价值。"
      ],
      "requiredChecksZh": [
        "可以取得 primary paper PDF 或 author submission。",
        "没有被已经存在的正式版本 canonical record 覆盖。",
