  "routingRules": [
    {
      "id": "core-object-primary",
      "ruleZh": "LEGO 或 Embroidery 是主要研究对象时，它始终是 primary topic，再依据真实任务增加技术方向。"
    },
    {
      "id": "technology-use-is-not-contribution",
      "ruleZh": "使用 Stable Diffusion、VLM、LLM、SAM 或 fabrication hardware 不自动进入对应方向；只有论文推进该方向时才交叉归类。"
    },
    {
      "id": "generation-vs-reconstruction",
      "ruleZh": "忠实恢复特定输入归 Reconstruction；创造 plausible 新内容归 Generation；两者都有独立贡献时才双归。"
    },
    {
      "id": "structured-vs-raster-2d",
      "ruleZh": "SVG、stroke、layer、vector 和 editable structure 归 2D Design；纯 raster pixels 归 Image Generation。"
    },
    {
      "id": "editing-follows-artifact",
      "ruleZh": "Editing 不独立成方向，按被编辑的 artifact 进入 2D Design、3D Generation、Image Generation 或 Video Generation。"
    },
    {
      "id": "fabrication-centrality",
      "ruleZh": "Fabrication process/material/assembly constraint 必须进入 generation 方法、目标函数或制造指令；仅 downstream demo 不算。"
    },
    {
      "id": "segmentation-encoder-gate",
      "ruleZh": "Point/mesh encoder 只有显著推进 segmentation 或 part representation 时才进入 3D Segmentation。"
    },
    {
      "id": "agent-vs-vlm",
      "ruleZh": "包装现有 VLM 完成闭环设计主要归 Visual Design Agents；提出新的 multimodal model/capability 主要归 VLM/MLLM。"
    },
    {
      "id": "canonical-paper-once",
      "ruleZh": "Canonical paper 只存一份；topicIds 可以多值，日报和 Library 中按 paper ID 去重。"
    }
  ],
